{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "font-awesome@6.7.2",
      "destination": "wwwroot/lib/font-awesome/",
      "files": [
        "css/all.min.css",
        "webfonts/fa-solid-900.woff2",
        "webfonts/fa-regular-400.woff2",
        "webfonts/fa-brands-400.woff2"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "@fontsource/inter@5.1.0",
      "destination": "wwwroot/lib/inter/",
      "files": [
        "400.css",
        "500.css",
        "600.css",
        "700.css",
        "files/inter-latin-400-normal.woff2",
        "files/inter-latin-500-normal.woff2",
        "files/inter-latin-600-normal.woff2",
        "files/inter-latin-700-normal.woff2",
        "files/inter-latin-ext-400-normal.woff2",
        "files/inter-latin-ext-500-normal.woff2",
        "files/inter-latin-ext-600-normal.woff2",
        "files/inter-latin-ext-700-normal.woff2"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "datatables.net@1.13.8",
      "destination": "wwwroot/lib/datatables/",
      "files": [
        "js/jquery.dataTables.min.js"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "datatables.net-bs5@1.13.8",
      "destination": "wwwroot/lib/datatables-bs5/",
      "files": [
        "js/dataTables.bootstrap5.min.js",
        "css/dataTables.bootstrap5.min.css"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "just-validate@4.3.0",
      "destination": "wwwroot/lib/just-validate/",
      "files": [
        "dist/just-validate.production.min.js"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "axios@1.7.9",
      "destination": "wwwroot/lib/axios/",
      "files": [
        "dist/axios.min.js"
      ]
    },
    {
      "provider": "jsdelivr",
      "library": "sweetalert2@11.14.5",
      "destination": "wwwroot/lib/sweetalert2/",
      "files": [
        "dist/sweetalert2.all.min.js"
      ]
    }
  ]
}