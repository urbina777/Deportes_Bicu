@{
    ViewData["Title"] = "Inicio";
    var esPersonal = User.HasAnyPermission("horario.ver", "inscripcion.ver", "asistencia.ver", "evaluacion.ver",
        "estudiante.ver", "entrenador.ver", "deporte.ver", "periodo.ver");
}

<div class="home-hero text-center py-4">
    <img src="~/img/logo.svg" alt="Logo" width="190" height="158" class="mb-3" />
    <h1 class="display-6">Sistema de Inscripciones Deportivas Universitarias</h1>
    <p class="text-muted">Inscripciones, horarios, asistencia y seguimiento físico de la actividad deportiva universitaria.</p>
</div>

<div class="row g-3 justify-content-center">
    @if (User.HasPermision("portalestudiante.ver"))
    {
        <div class="col-md-4">
            <div class="card admin-card h-100"><div class="card-body">
                <h5 class="card-title"><i class="fa-solid fa-user-graduate me-2"></i>Mi portal</h5>
                <p class="card-text text-muted">Consulte sus inscripciones, asistencias y evaluaciones físicas, e inscríbase a un deporte.</p>
                <a class="btn btn-primary btn-sm" asp-controller="PortalEstudiante" asp-action="Index">Ir a mi portal</a>
            </div></div>
        </div>
    }
    @if (User.HasPermision("portalentrenador.ver"))
    {
        <div class="col-md-4">
            <div class="card admin-card h-100"><div class="card-body">
                <h5 class="card-title"><i class="fa-solid fa-person-running me-2"></i>Portal del entrenador</h5>
                <p class="card-text text-muted">Vea sus horarios y registre la asistencia de los estudiantes inscritos.</p>
                <a class="btn btn-primary btn-sm" asp-controller="PortalEntrenador" asp-action="Index">Ir al portal</a>
            </div></div>
        </div>
    }
    @if (esPersonal)
    {
        <div class="col-md-4">
            <div class="card admin-card h-100"><div class="card-body">
                <h5 class="card-title"><i class="fa-solid fa-clipboard-list me-2"></i>Gestión deportiva</h5>
                <p class="card-text text-muted">Use el menú superior para administrar catálogos, personas, horarios e inscripciones según sus permisos.</p>
            </div></div>
        </div>
    }
    @if (!User.HasAnyPermission("portalestudiante.ver", "portalentrenador.ver") && !esPersonal)
    {
        <div class="col-md-6">
            <div class="alert alert-info mb-0">
                Su cuenta todavía no tiene permisos asignados. Solicite al administrador que se los otorgue y luego pulse
                <strong>Actualizar sesión</strong>.
            </div>
        </div>
    }
</div>
