@{
    ViewData["Title"] = "Mi portal";
    var tienePerfil = (bool)(ViewBag.TienePerfil ?? false);
}

<div class="mb-4">
    <h1 class="h3 mb-1">Mi portal deportivo</h1>
    <p class="text-muted mb-0">Consulte sus inscripciones, asistencias y evaluaciones físicas</p>
</div>

@if (!tienePerfil)
{
    <div class="alert alert-warning">
        Su cuenta todavía no tiene un perfil de estudiante. Solicite al personal administrativo que lo registre.
    </div>
}
else
{
    <div class="card admin-card mb-4">
        <div class="card-body" id="miPerfil">
            <span class="text-muted">Cargando datos...</span>
        </div>
    </div>

    <ul class="nav nav-tabs mb-3" role="tablist">
        <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tabInscripciones" type="button">Mis inscripciones</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabAsistencias" type="button">Mis asistencias</button></li>
        <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tabEvaluaciones" type="button">Mis evaluaciones</button></li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="tabInscripciones">
            @if (User.HasPermision("portalestudiante.inscribir"))
            {
                <div class="d-flex justify-content-end mb-2">
                    <button type="button" class="btn btn-success btn-sm" id="btnNuevaInscripcion">
                        <i class="fa-solid fa-plus me-1"></i>Nueva inscripción
                    </button>
                </div>
            }
            <div class="card admin-card"><div class="card-body">
                <table id="misInscripcionesTable" class="table table-striped table-hover w-100">
                    <thead>
                        <tr><th>Fecha</th><th>Deporte</th><th>Categoría</th><th>Período</th><th>Horarios</th><th>Asistencias</th><th>Estado</th><th></th></tr>
                    </thead>
                </table>
            </div></div>
        </div>
        <div class="tab-pane fade" id="tabAsistencias">
            <div class="card admin-card"><div class="card-body">
                <table id="misAsistenciasTable" class="table table-striped table-hover w-100">
                    <thead><tr><th>Fecha</th><th>Deporte</th><th>Período</th><th>Estado</th></tr></thead>
                </table>
            </div></div>
        </div>
        <div class="tab-pane fade" id="tabEvaluaciones">
            <div class="card admin-card"><div class="card-body">
                <table id="misEvaluacionesTable" class="table table-striped table-hover w-100">
                    <thead><tr><th>Fecha</th><th>Peso (kg)</th><th>Estatura (m)</th><th>Observaciones</th></tr></thead>
                </table>
            </div></div>
        </div>
    </div>

    @if (User.HasPermision("portalestudiante.inscribir"))
    {
        <partial name="_InscripcionModal" model="@false" />
    }
}

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables-bs5/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    @if (tienePerfil)
    {
        <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
        <script src="~/lib/datatables-bs5/js/dataTables.bootstrap5.min.js"></script>
        <script src="~/lib/just-validate/dist/just-validate.production.min.js"></script>
        <script>
            window.portalEstudianteConfig = {
                canInscribir: @User.HasPermision("portalestudiante.inscribir").ToString().ToLower()
            };
        </script>
        <script src="~/js/inscripcion-form.js" asp-append-version="true"></script>
        <script src="~/js/portal-estudiante.js" asp-append-version="true"></script>
    }
}
