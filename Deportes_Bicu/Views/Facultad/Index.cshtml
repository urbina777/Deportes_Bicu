@{
    ViewData["Title"] = "Facultades";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Facultades</h1>
        <p class="text-muted mb-0">Gestión de datos con DataTable</p>
    </div>
    @if (User.HasPermision("facultad.crear"))
    {
        <button type="button" class="btn btn-success btn-sm" id="btnNuevaFacultad">
            <i class="fa-solid fa-plus me-1"></i>Nueva Facultad
        </button>
    }
</div>

<div class="card admin-card">
    <div class="card-body">
        <table id="facultadTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Carreras</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="facultadModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="facultadModalTitle">Facultad</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="facultadForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="facultadId" />
                    <div class="mb-3">
                        <label class="form-label" for="facultadNombre">Nombre</label>
                        <input type="text" id="facultadNombre" name="facultadNombre" class="form-control" maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="facultadDescripcion">Descripción</label>
                        <input type="text" id="facultadDescripcion" name="facultadDescripcion" class="form-control" maxlength="200" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="btnGuardarFacultad">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables-bs5/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/lib/just-validate/dist/just-validate.production.min.js"></script>
    <script>
        window.facultadConfig = {
            canUpdate: @User.HasPermision("facultad.actualizar").ToString().ToLower(),
            canDelete: @User.HasPermision("facultad.borrar").ToString().ToLower()
        };
    </script>
    <script src="~/js/facultad.js" asp-append-version="true"></script>
}
