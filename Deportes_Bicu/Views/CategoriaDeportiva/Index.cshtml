@{
    ViewData["Title"] = "Categorías deportivas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Categorías deportivas</h1>
        <p class="text-muted mb-0">Gestión de datos con DataTable</p>
    </div>
    @if (User.HasPermision("categoria.crear"))
    {
        <button type="button" class="btn btn-success btn-sm" id="btnNuevaCategoriaDeportiva">
            <i class="fa-solid fa-plus me-1"></i>Nueva Categoría deportiva
        </button>
    }
</div>

<div class="card admin-card">
    <div class="card-body">
        <table id="categoriaDeportivaTable" class="table table-striped table-hover w-100">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Edad mínima</th>
                    <th>Edad máxima</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<div class="modal fade" id="categoriaDeportivaModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="categoriaDeportivaModalTitle">Categoría deportiva</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="categoriaDeportivaForm" novalidate>
                <div class="modal-body">
                    <input type="hidden" id="categoriaDeportivaId" />
                    <div class="mb-3">
                        <label class="form-label" for="categoriaDeportivaNombre">Nombre</label>
                        <input type="text" id="categoriaDeportivaNombre" name="categoriaDeportivaNombre" class="form-control" maxlength="80" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="categoriaDeportivaEdadMinima">Edad mínima</label>
                        <input type="number" id="categoriaDeportivaEdadMinima" name="categoriaDeportivaEdadMinima" class="form-control" min="0" max="120" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="categoriaDeportivaEdadMaxima">Edad máxima</label>
                        <input type="number" id="categoriaDeportivaEdadMaxima" name="categoriaDeportivaEdadMaxima" class="form-control" min="0" max="120" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="btnGuardarCategoriaDeportiva">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/lib/datatables-bs5/css/dataTables.bootstrap5.min.css" />
}

@section Scripts {
    <script src="~/lib/datatables/js/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables-bs5/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/lib/just-validate/dist/just-validate.production.min.js"></script>
    <script>
        window.categoriaDeportivaConfig = {

            canUpdate: @User.HasPermision("categoria.actualizar").ToString().ToLower(),
            canDelete: @User.HasPermision("categoria.borrar").ToString().ToLower()
        };
    </script>
    <script src="~/js/categoriadeportiva.js" asp-append-version="true"></script>
}
